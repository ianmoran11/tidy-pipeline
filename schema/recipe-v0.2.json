{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tidy-recipe-v0.2",
  "title": "Tidy recipe for one spreadsheet sheet",
  "description": "Stored as tidy-recipes/<sheet_sha256>.json. Cell references are A1 addresses or ranges, optionally comma-separated (\"A8:A11,A13\").",
  "type": "object",
  "required": [
    "version",
    "sheet_sha256",
    "sheet",
    "kind",
    "status"
  ],
  "properties": {
    "version": {
      "const": "0.2"
    },
    "sheet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sheet": {
      "type": "string",
      "description": "Exact sheet name, including any trailing spaces"
    },
    "kind": {
      "enum": [
        "data",
        "contents",
        "notes",
        "empty",
        "unsupported"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "validated",
        "needs_review"
      ],
      "description": "Set by submit_recipe. Authors write draft."
    },
    "reason": {
      "type": "string",
      "description": "Required when kind is not data"
    },
    "template_from": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "agent_notes": {
      "type": "string"
    },
    "new_dimensions": {
      "type": "array",
      "description": "Names used in this recipe that are not in dictionary/dimensions.csv, for human review",
      "items": {
        "type": "object",
        "required": [
          "name",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
          },
          "description": {
            "type": "string",
            "minLength": 15
          },
          "example_labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "meta_data": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/meta_item"
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/table"
      }
    },
    "validation": {
      "type": "object",
      "description": "Written by submit_recipe"
    },
    "generation": {
      "type": "object",
      "description": "How the recipe was produced: agent settings, skill file hashes, and the exact prompt. Written by submit_recipe in agent runs; not used by the pipeline.",
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "enum": [
            "agent",
            "interactive",
            "manual"
          ]
        },
        "run_id": {
          "type": "string"
        },
        "agent": {
          "type": "object"
        },
        "skill": {
          "type": "object"
        },
        "prompt": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "data"
          }
        }
      },
      "then": {
        "required": [
          "tables"
        ],
        "properties": {
          "tables": {
            "minItems": 1
          }
        }
      },
      "else": {
        "required": [
          "reason"
        ]
      }
    }
  ],
  "$defs": {
    "cells": {
      "type": "string",
      "pattern": "^[A-Z]{1,3}[0-9]+(:[A-Z]{1,3}[0-9]+)?(,[A-Z]{1,3}[0-9]+(:[A-Z]{1,3}[0-9]+)?)*$"
    },
    "meta_item": {
      "type": "object",
      "required": [
        "name",
        "cells"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
          "description": "dictionary/dimensions.csv name (sheet_metadata names at sheet level)"
        },
        "cells": {
          "$ref": "#/$defs/cells"
        },
        "caption": {
          "type": "string",
          "description": "The publisher's caption for this dimension, exactly as printed"
        }
      }
    },
    "header": {
      "type": "object",
      "required": [
        "name",
        "direction",
        "cells"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
          "not": {
            "enum": [
              "row",
              "col",
              "address"
            ]
          },
          "description": "dictionary/dimensions.csv name, or one declared in new_dimensions"
        },
        "direction": {
          "enum": [
            "N",
            "NNW",
            "NNE",
            "E",
            "ENE",
            "ESE",
            "S",
            "SSE",
            "SSW",
            "W",
            "WNW",
            "WSW",
            "ABOVE",
            "BELOW",
            "LEFT",
            "RIGHT",
            "up",
            "up-left",
            "up-right",
            "right",
            "right-up",
            "right-down",
            "down",
            "down-left",
            "down-right",
            "left",
            "left-up",
            "left-down",
            "up-ish",
            "right-ish",
            "down-ish",
            "left-ish"
          ]
        },
        "cells": {
          "$ref": "#/$defs/cells"
        },
        "caption": {
          "type": "string",
          "description": "The publisher's caption for this dimension, exactly as printed"
        }
      }
    },
    "table": {
      "type": "object",
      "required": [
        "name",
        "range",
        "values_range",
        "headers"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "range": {
          "$ref": "#/$defs/cells",
          "description": "Whole table area, including its headers"
        },
        "values_range": {
          "$ref": "#/$defs/cells",
          "description": "Data cells only; no blank spacer rows"
        },
        "meta_data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/meta_item"
          }
        },
        "headers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/header"
          }
        }
      }
    }
  }
}