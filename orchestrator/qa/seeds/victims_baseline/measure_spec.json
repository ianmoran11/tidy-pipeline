{
  "description": "Stage 4 (identify): what each record counts. See measures/README.md.",
  "subject_pattern": "^(?:FDV\\s+|ANZSOC 2023\\s+)?(?:Table\\s*[A-Z]{0,3}\\s*[0-9]+(?-i:[a-z])?\\s*[:.–-]?\\s*)?(?:Experimental data(?:\\s*\\([a-z0-9]{1,2}\\))?\\s*[–-]\\s*)?([^,]+)",
  "replace_labels": {
    "population": [
      "Total"
    ]
  },
  "title_flags": [
    {
      "pattern": "^ANZSOC 2023\\b|Preliminary ANZSOC 2023",
      "set": {
        "offence_classification": "ANZSOC 2023 (preliminary)"
      }
    },
    {
      "pattern": "Experimental data",
      "set": {
        "data_status": "Experimental"
      }
    },
    {
      "pattern": "45130DO00[26]_(200910|201011)",
      "set": {
        "court_level": "Higher Courts"
      }
    },
    {
      "pattern": "45130DO00[37]_(200910|201011)",
      "set": {
        "court_level": "Magistrates' Courts"
      }
    },
    {
      "pattern": "45130DO00[48]_(200910|201011)",
      "set": {
        "court_level": "Children's Courts"
      }
    },
    {
      "pattern": "45130DO005_200910",
      "set": {
        "court_level": "All Courts"
      }
    },
    {
      "pattern": "aggregate sentence length",
      "set": {
        "sentence_basis": "Aggregate sentence length"
      }
    },
    {
      "pattern": "expected time to serve",
      "set": {
        "sentence_basis": "Expected time to serve"
      }
    },
    {
      "pattern": "offences for federal prisoners",
      "set": {
        "population": "Federal prisoners"
      }
    },
    {
      "pattern": "offences for federal parolees",
      "set": {
        "population": "Federal parolees"
      }
    },
    {
      "pattern": "45130DO002_200809",
      "set": {
        "court_level": "Higher Courts"
      }
    },
    {
      "pattern": "45130DO003_200809",
      "set": {
        "court_level": "Magistrates' Courts"
      }
    },
    {
      "pattern": "45130DO004_200809",
      "set": {
        "court_level": "Children's Courts"
      }
    },
    {
      "pattern": "excluding road traffic offences",
      "set": {
        "scope": "Excluding road traffic offences"
      }
    }
  ],
  "measure_from_unit": {
    "no.": "Number",
    "%": "Proportion"
  },
