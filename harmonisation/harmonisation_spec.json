      "dimension": "state",
      "pattern": "(?<![A-Za-z])(New South Wales|Victoria|Queensland|South Australia|Western Australia|Tasmania|Northern Territory|Australian Capital Territory)(?![A-Za-z])",
      "values": {
        "new south wales": "NSW",
