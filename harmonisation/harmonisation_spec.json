        [
          "^([0-9]{4})-([0-9]{2})$",
          "\\1–\\2"
        ]
      ]
    },
    {
      "dimension": "period",
      "pattern": ", ((?:19|20)[0-9]{2})\\s*(?=/|$)"
    },
    {
      "dimension": "principal_offence",
      "pattern": "(?:^| / )Table [0-9]+[a-z]? Federal defendants[^,]*, (.+?), Summary characteristics"
    },
    {
      "dimension": "principal_offence",
