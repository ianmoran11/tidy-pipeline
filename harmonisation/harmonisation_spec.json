        "south australia": "SA",
        "western australia": "WA",
        "tasmania": "Tas.",
        "northern territory": "NT",
        "australian capital territory": "ACT"
      }
    },
    {
      "dimension": "state",
      "pattern": "–\\s*(Australia)(?![A-Za-z])",
      "value": "Australia"
    },
    {
      "dimension": "court_level",
      "pattern": "(?<![A-Za-z])(Higher Courts?|Magistrates'? Courts?|Children's Courts?|All Courts)(?![A-Za-z])",
