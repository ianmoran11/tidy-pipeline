    },
    {
      "dimension": "period",
      "pattern": "(?<![0-9])((?:[0-9]{1,2} )?(?:January|February|March|April|May|June|July|August|September|October|November|December) (?:19|20)[0-9]{2})(?![0-9])"
    },
    {
      "dimension": "period",
      "pattern": "(?<!to )(?<![0-9])(?<![0-9][–-])((?:19|20)[0-9]{2}[–-][0-9]{2})\\s*(?:\\([^)]*\\))?\\s*(?=/|$)",
