    {
      "pattern": "^Up ([0-9]+(?:\\.[0-9]+)?)%$",
      "replacement": "\\1",
      "description": "BOCSAR trend: significant rise, average annual percentage change (Up 4.2% is 4.2)"
    },
    {
      "pattern": "^Down ([0-9]+(?:\\.[0-9]+)?)%$",
      "replacement": "-\\1",
      "description": "BOCSAR trend: significant fall (Down 4.2% is -4.2)"
    },
    {
      "pattern": "^(-?[0-9]+(?:\\.[0-9]+)?) ?p\\.p\\.?$",
      "replacement": "\\1",
      "description": "BOCSAR clear-up rates: change in percentage points (1.9 p.p)"
    },
    {
      "pattern": "^(-?[0-9]+(?:\\.[0-9]+)?)x$",
      "replacement": "\\1",
      "description": "BOCSAR Closing the Gap: rate ratio (11.1x)"
    }
  ]
