{
  "description": "Stage 6 (type_values): what each publisher's symbols mean. Symbols are matched after squishing spaces; a publication's own entries win over 'default'. 'value' is set only where the symbol stands for a number.",
  "number_status": "published",
  "blank_status": "blank",
  "markers": [
    {
      "pattern": "^(?:\\([a-z]{1,2}\\))+\\s*(?=[-*r0-9.])",
      "flag": "footnote",
      "description": "footnote markers attached to the number, e.g. (b)(c)25.3"
    },
    {
      "pattern": "^r(?=-?[0-9.])",
      "flag": "revised",
      "description": "r revised since the previous release"
    },
    {
      "pattern": "^\\*\\*\\s*(?=-?[0-9.])",
      "flag": "rse_over_50",
      "description": "** estimate has a relative standard error over 50% (ABS, RoGS): too unreliable for general use"
    },
    {
      "pattern": "^\\*\\s*(?=-?[0-9.])",
      "flag": "rse_25_to_50",
      "description": "* estimate has a relative standard error of 25% to 50% (ABS, RoGS): use with caution"
    }
  ],
